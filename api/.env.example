NODE_ENV="development" # also can be production, staging, test, etc

PORT=3000

DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

JWT_SECRET="your-secret"

# para testes no expo, utilize a url do expo
# mantenha os dois hífens "--" no final
FRONTEND_URL="exp://your_ip:8081/--"

# id e secret gerados na plataforma do google
GOOGLE_CLIENT_ID="id"
GOOGLE_CLIENT_SECRET="secret"
# pode ser utilizada nas portas 3000 e 4000
# conforme configurado no Google Auth Platform
# adeque sua API para isso caso configure de outra forma
# adicione o seu_ip.nip.io:porta ao seu client do google oauth
GOOGLE_CALLBACK_URL="http://your_ip.nip.io:3000/auth/google/redirect"

# key gerada para a api do portal da transparencia no gov.br
PT_API_KEY="api-key"
PT_API_URL="https://api.portaldatransparencia.gov.br/api-de-dados"
SIAPE_IFCE="26405" # (IFCE) com base na instituição desejada

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu_email@gmail.com"
SMTP_PASS="your-gmail-app-password"
