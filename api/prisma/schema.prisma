generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  TECNICO
  PROFESSOR
  ALUNO
}

enum CategoriaInsumo {
  EQUIPAMENTO
  VIDRARIA
  SOLUCAO
  REAGENTE
}

enum MedidasEntidades {
  MG  // Miligrama
  G   // Grama
  KG  // Quilograma
  ML  // Mililitro
  L   // Litro
  UN  // Unidade
}

model Usuario {
  id           String                @id @default(uuid())
  nome         String
  email        String                @unique
  perfil       Perfil
  created_at   DateTime              @default(now())
  reservas     ReservaEspaco[]
  solicitacoes SolicitacaoMaterial[]
  avarias      AvariaReportada[]
}

model ReservaEspaco {
  id           String   @id @default(uuid())
  professor_id String
  professor    Usuario  @relation(fields: [professor_id], references: [id])
  data_inicio  DateTime
  data_fim     DateTime
  prioridade   Int
  status       String
  created_at   DateTime @default(now())
}

model Insumo {
  id                String           @id @default(uuid())
  nome              String
  categoria         CategoriaInsumo
  quantidade_saldo  Int
  localizacao       String?
  quantidade_minima Int?
  status            String           @default("Disponível")
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt @default(now())
  tipo_medida       MedidasEntidades
  data_validade     DateTime

  solicitacoes SolicitacaoMaterial[]
  avarias      AvariaReportada[]

  reagenteInfo    Reagente?
  solucaoInfo     Solucao?
  equipamentoInfo Equipamento?
  vidrariaInfo    Vidraria?
}

model Reagente {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  formula    String?
  cas        String?
  marca      String?
  observacao String?
}

model Solucao {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  formula    String?
  cas        String?
  observacao String?
}

model Equipamento {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  marca    String?
  modelo   String?
  voltagem String?
}

model Vidraria {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  marca      String?
  capacidade String?
}

model SolicitacaoMaterial {
  id             String                  @id @default(uuid())
  solicitante_id String
  solicitante    Usuario                 @relation(fields: [solicitante_id], references: [id])
  insumo_id      String
  insumo         Insumo                  @relation(fields: [insumo_id], references: [id])
  quantidade     Int
  data_retirada  DateTime
  data_limite    DateTime
  status         String
  historicos     HistoricoMovimentacao[]
}

model AvariaReportada {
  id           String   @id @default(uuid())
  usuario_id   String
  usuario      Usuario  @relation(fields: [usuario_id], references: [id])
  insumo_id    String
  insumo       Insumo   @relation(fields: [insumo_id], references: [id])
  descricao    String
  data_reporte DateTime @default(now())
}

model HistoricoMovimentacao {
  id             String              @id @default(uuid())
  solicitacao_id String
  solicitacao    SolicitacaoMaterial @relation(fields: [solicitacao_id], references: [id])
  acao           String
  data_evento    DateTime            @default(now())
  observacao     String?
}
