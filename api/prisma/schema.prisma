generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  TECNICO
  PROFESSOR
  ALUNO
}

enum CategoriaInsumo {
  EQUIPAMENTO
  VIDRARIA
  SOLUCAO
  REAGENTE
}

enum MedidasEntidades {
  MG // Miligrama
  G // Grama
  KG // Quilograma
  ML // Mililitro
  L // Litro
  UN // Unidade
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
  DEVOLVIDA
}

enum TipoMovimentacao {
  SOLICITACAO
  SAIDA
  ENTRADA
  DEVOLUCAO
  AVARIA
}

enum ObjetivoReserva {
  AULA_PRATICA
  PROJETO_EXTENSAO
  TCC
  PESQUISA
}

enum StatusReserva {
  PENDENTE
  AVISO_SIMPLES
  APROVADA
  REJEITADA
  CANCELADA
  CONCLUIDA_COM_ATA
}

enum StatusAlerta {
  PENDENTE
  REPOSICAO_SOLICITADA
  RESOLVIDO
}

enum StatusInsumo {
  CRITICO
  ESTAVEL
  NAO_APLICAVEL
}

enum NaturezaPatrimonial {
  TOMBADO
  CONSUMO
}

enum TipoAvaria {
  QUEBRA
  DEFEITO
  CONTAMINACAO
  EXTRAVIO
  OUTRO
}

enum StatusAta {
  PENDENTE
  EM_ANALISE
  RESOLVIDA
}

enum TipoOcorrenciaAta {
  SEM_INTERCORRENCIAS
  AVARIA_MATERIAL
  FALTA_REAGENTE
  INCIDENTE_SEGURANCA
}

model Usuario {
  id                String    @id @default(uuid())
  nome              String
  email             String    @unique
  senha             String
  perfil            Perfil
  codigoRedefinicao String?
  codigoExpiracao   DateTime?

  created_at           DateTime                @default(now())
  reservas             ReservaEspaco[]
  solicitacoes         SolicitacaoMaterial[]   @relation("solicitante")
  solicitacoes_tecnico SolicitacaoMaterial[]   @relation("SolicitacaoMaterial_Tecnico")
  movimentacoes        HistoricoMovimentacao[]
  avarias              AvariaReportada[]
  atas_analisadas      AtaUso[]                @relation("AtaUso_Tecnico")
}

model Laboratorio {
  id          String   @id @default(uuid())
  nome        String   @unique
  localizacao String?
  capacidade  Int      @default(0)
  ativo       Boolean  @default(true)
  created_at  DateTime @default(now())
}

model ReservaEspaco {
  id           String  @id @default(uuid())
  professor_id String
  professor    Usuario @relation(fields: [professor_id], references: [id])

  local              String
  data_reserva       DateTime
  dia_semana         Int // 0 (Dom) a 6 (Sáb)
  objetivo           ObjetivoReserva
  titulo             String
  professor_responsavel String?
  quantidade_alunos  Int             @default(0)
  quantidade_grupos  Int             @default(0)
  observacoes        String?
  pratica_recorrente Boolean         @default(false)
  status             StatusReserva   @default(PENDENTE)
  motivo_rejeicao    String?
  analisada_em       DateTime?

  horarios   HorarioReserva[]
  created_at DateTime         @default(now())

  ataUso              AtaUso?
  solicitacaoMaterial SolicitacaoMaterial?
}

model HorarioReserva {
  id         String        @id @default(uuid())
  reserva_id String
  reserva    ReservaEspaco @relation(fields: [reserva_id], references: [id], onDelete: Cascade)

  hora_inicio String
  hora_fim    String
}

model Insumo {
  id        String          @id @default(uuid())
  nome      String
  categoria CategoriaInsumo

  quantidade_saldo  Decimal @default(0) @db.Decimal(10, 3)
  quantidade_minima Decimal @default(0) @db.Decimal(10, 3)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  tipo_medida   MedidasEntidades
  data_validade DateTime?

  localizacao          String?
  statusInsumo         StatusInsumo        @default(NAO_APLICAVEL)
  natureza_patrimonial NaturezaPatrimonial @default(CONSUMO)
  alertasEstoque       AlertaEstoque[]

  itensSolicitacao ItemSolicitacaoMaterial[]
  avarias          AvariaReportada[]

  reagenteInfo    Reagente?
  solucaoInfo     Solucao?
  equipamentoInfo Equipamento?
  vidrariaInfo    Vidraria?

  historicosMovimentacao HistoricoMovimentacao[]
}

model Reagente {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  formula    String?
  cas        String?
  marca      String?
  observacao String?
}

model Solucao {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  formula    String?
  cas        String?
  observacao String?
}

model Equipamento {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  marca        String?
  modelo       String?
  voltagem     String?
  patrimonio   String?
  uso_restrito Boolean @default(false)
}

model Vidraria {
  id String @id @default(uuid())

  insumo_id String @unique
  insumo    Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  marca      String?
  capacidade String?
}

model SolicitacaoMaterial {
  id                     String           @id @default(uuid())
  solicitante_id         String
  solicitante            Usuario          @relation("solicitante", fields: [solicitante_id], references: [id])
  reserva_id             String?          @unique
  reserva                ReservaEspaco?   @relation(fields: [reserva_id], references: [id], onDelete: SetNull)
  objetivo               ObjetivoReserva?
  finalidade             String?
  descricao              String?
  devolucao_informada_em DateTime?

  status StatusSolicitacao @default(PENDENTE)

  tecnico_id     String?
  tecnico        Usuario?                  @relation("SolicitacaoMaterial_Tecnico", fields: [tecnico_id], references: [id])
  criada_em      DateTime                  @default(now())
  aprovada_em    DateTime?
  data_retirada  DateTime?
  data_devolucao DateTime?
  devolvida_em   DateTime?
  itens          ItemSolicitacaoMaterial[]
  historicos     HistoricoMovimentacao[]

  motivo_rejeicao String?
}

model ItemSolicitacaoMaterial {
  id String @id @default(uuid())

  solicitacao_id String
  solicitacao    SolicitacaoMaterial @relation(fields: [solicitacao_id], references: [id], onDelete: Cascade)

  insumo_id String
  insumo    Insumo @relation(fields: [insumo_id], references: [id])

  quantidade           Decimal  @db.Decimal(10, 3)
  quantidade_devolvida Decimal? @db.Decimal(10, 3)
}

model AvariaReportada {
  id         String  @id @default(uuid())
  usuario_id String
  usuario    Usuario @relation(fields: [usuario_id], references: [id])
  insumo_id  String
  insumo     Insumo  @relation(fields: [insumo_id], references: [id])
  ata_uso_id String?
  ataUso     AtaUso? @relation(fields: [ata_uso_id], references: [id], onDelete: SetNull)

  quantidade      Decimal    @db.Decimal(10, 3)
  tipo_ocorrencia TipoAvaria
  descricao       String?
  foto_url        String?

  data_reporte DateTime @default(now())
}

model HistoricoMovimentacao {
  id             String               @id @default(uuid())
  solicitacao_id String?
  solicitacao    SolicitacaoMaterial? @relation(fields: [solicitacao_id], references: [id])
  insumo_id      String
  insumo         Insumo               @relation(fields: [insumo_id], references: [id])
  acao           TipoMovimentacao
  quantidade     Decimal              @db.Decimal(10, 3)

  saldo_anterior  Decimal @db.Decimal(10, 3)
  saldo_posterior Decimal @db.Decimal(10, 3)

  data_evento DateTime @default(now())

  observacao String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId  String?
}

model AlertaEstoque {
  id                 String       @id @default(uuid())
  insumo_id          String
  insumo             Insumo       @relation(fields: [insumo_id], references: [id])
  quantidade_momento Decimal      @db.Decimal(10, 3)
  data_alerta        DateTime     @default(now())
  status             StatusAlerta @default(PENDENTE)

  // Campos para histórico de resolução
  data_resolucao       DateTime?
  quantidade_resolucao Decimal?  @db.Decimal(10, 3)
}

model AtaUso {
  id                   String            @id @default(uuid())
  codigo               Int               @unique @default(autoincrement())
  reservaId            String            @unique
  reserva              ReservaEspaco     @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  nomePratica          String
  professorResponsavel String
  numeroAlunos         Int
  ocorrencias          TipoOcorrenciaAta[]   @default([SEM_INTERCORRENCIAS])
  relatoAula           String?           @db.Text
  pendenciasTecnico    String?           @db.Text
  status               StatusAta         @default(PENDENTE)
  tecnicoId            String?
  tecnico              Usuario?          @relation("AtaUso_Tecnico", fields: [tecnicoId], references: [id])
  analisadaEm          DateTime?
  resolvidaEm          DateTime?
  avarias              AvariaReportada[]
  criadoEm             DateTime          @default(now())
  atualizadoEm         DateTime          @updatedAt
}
